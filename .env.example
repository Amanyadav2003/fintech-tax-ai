BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_NAME=TaxMate AI
BREVO_SENDER_EMAIL=verified-sender@example.com
# TaxMate AI - Environment Configuration Example
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=postgresql://postgres:your_secure_password@db:5432/taxmate_ai
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=taxmate_ai

# Security Keys - MUST BE GENERATED
# To generate SECRET_KEY: 
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# To generate ENCRYPTION_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=generate_secure_key_32_chars_minimum
ENCRYPTION_KEY=generate_secure_key_using_fernet
FRONTEND_URL=http://localhost:3001

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000/api

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment
ENVIRONMENT=development
APP_VERSION=1.0.0

# Sentry Error Tracking (optional)
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Security Settings
SECURE_COOKIES=false  # Set to true in production with HTTPS
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
